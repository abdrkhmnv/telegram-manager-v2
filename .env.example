# =============================================================
# Telegram Manager v2 — muhit o'zgaruvchilari namunasi
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring:
#     cp .env.example .env && chmod 600 .env
# .env fayli HECH QACHON Git'ga commit qilinmaydi.
# Izohlar alohida qatorda yoziladi (qiymat yonida emas).
# =============================================================

# --- Ilova ---
# development | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
# Log fayllari katalogi. Bo'sh qoldirilsa faqat konsolga yoziladi.
LOG_DIR=logs
TIMEZONE=Asia/Tashkent
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=50

# --- PostgreSQL ---
# Format: postgresql+asyncpg://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA
# Docker Compose ichida HOST=db bo'ladi (docker-compose.yml o'zi almashtiradi).
DATABASE_URL=postgresql+asyncpg://tgmanager:CHANGE_ME@localhost:5432/tgmanager
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
DB_ECHO=false

# docker-compose'dagi PostgreSQL konteyneri uchun (DATABASE_URL bilan mos bo'lsin)
POSTGRES_USER=tgmanager
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tgmanager

# --- Telegram (run va login uchun majburiy) ---
# https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# @BotFather bergan Control Bot tokeni
BOT_TOKEN=
# Panelga kira oladigan YAGONA foydalanuvchining Telegram ID raqami
OWNER_TELEGRAM_ID=
# Telethon sessiya fayli saqlanadigan katalog (ruxsatlar: 700)
SESSION_DIR=storage/sessions
SESSION_NAME=userbot
